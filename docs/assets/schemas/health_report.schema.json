{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthReport",
  "type": "object",
  "properties": {
    "checked": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HealthIssue"
      }
    }
  },
  "required": [
    "checked",
    "issues"
  ],
  "$defs": {
    "HealthIssue": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "category",
        "error"
      ]
    }
  }
}