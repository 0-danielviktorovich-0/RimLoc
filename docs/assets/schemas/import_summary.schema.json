{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportSummary",
  "type": "object",
  "properties": {
    "created": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportFileStat"
      }
    },
    "keys": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "mode": {
      "type": "string"
    },
    "skipped": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "updated": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "required": [
    "mode",
    "created",
    "updated",
    "skipped",
    "keys",
    "files"
  ],
  "$defs": {
    "ImportFileStat": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keys": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "keys",
        "status",
        "added",
        "changed"
      ]
    }
  }
}