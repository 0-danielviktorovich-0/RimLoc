{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnnotatePlan",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnnotateFilePlan"
      }
    },
    "processed": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "total_add": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "total_strip": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "required": [
    "files",
    "total_add",
    "total_strip",
    "processed"
  ],
  "$defs": {
    "AnnotateFilePlan": {
      "type": "object",
      "properties": {
        "add": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "strip": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "add",
        "strip"
      ]
    }
  }
}