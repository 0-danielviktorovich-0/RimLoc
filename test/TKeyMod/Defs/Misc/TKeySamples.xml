      <li TKey="DismissLetters">You can dismiss letters by right-clicking.</li>
    </tips>
  </TipSetDef>
  <QuestScriptDef>
    <defName>SampleQuest</defName>
    <label TKey="LetterLabelFavorReceiver">sample favor label</label>
