{
  "name": "rimloc-gui-frontend-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Svelte 5 mock scaffold for the RimLoc GUI per docs/development/GUI_DESIGN_SPEC.md",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "export:catalog": "tsx scripts/export-catalog.ts",
    "build:contribution": "tsx scripts/build-contribution.ts",
    "apply:contribution": "tsx scripts/apply-contribution.ts",
    "scenes:t5": "node e2e/scenes/generate-t5-scenes.mjs",
    "snapshot:semantic": "node e2e/scenes/semantic-snapshot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^30.1.1",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.0",
    "tslib": "^2.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
