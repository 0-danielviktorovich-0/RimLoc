{
  "$schema": "https://schema.tauri.app/capability.json",
  "identifier": "default",
  "description": "Default capability: dialog open/save for main window; wdio-webdriver permission is dormant unless RIMLOC_AUTOMATION=1 registers the plugin.",
  "local": true,
  "windows": [
    "main",
    "*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "wdio-webdriver:default",
    "wdio:default",
    "wdio:allow-execute",
    "wdio:allow-log-frontend",
    "wdio:allow-debug-plugin",
    "wdio:allow-get-active-window-label",
    "wdio:allow-get-window-states",
    "wdio:allow-list-windows"
  ]
}