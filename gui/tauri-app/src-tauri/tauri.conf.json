{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RimLoc GUI",
  "version": "0.1.0",
  "identifier": "com.rimloc.gui",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "pattern": {
        "use": "brownfield"
      }
    },
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "RimLoc GUI",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Tauri desktop GUI for RimLoc",
    "publisher": "RimLoc Team"
  },
  "plugins": {}
}