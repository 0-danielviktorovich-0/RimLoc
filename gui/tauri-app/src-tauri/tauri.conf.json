{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RimLoc GUI",
  "version": "0.1.0-beta.1",
  "identifier": "com.rimloc.gui",
  "build": {
    "frontendDist": "../frontend-react/dist",
    "beforeBuildCommand": "cd frontend-react && npm run build",
    "beforeDevCommand": "cd frontend-react && npm run dev",
    "devUrl": "http://localhost:5175"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "pattern": {
        "use": "brownfield"
      },
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "RimLoc",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "devtools": true,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Tauri desktop GUI for RimLoc",
    "publisher": "RimLoc Team",
    "resources": {
      "../frontend-v2/src/i18n/generated": "selfloc-catalog"
    }
  },
  "plugins": {}
}
